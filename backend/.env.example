# Clan Nexus Backend Environment Variables

# MongoDB Connection String (REQUIRED)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/clan_nexus

# Database Name
DB_NAME=clan_nexus

# JWT Secret for authentication (REQUIRED - Change this!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origins - comma separated
CORS_ORIGINS=https://voluble-longma-e32a79.netlify.app,http://localhost:3000

# Port
PORT=8000
